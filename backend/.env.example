# ===== School POS — variables de entorno =====
# Copia este archivo a .env y pon los valores reales.

# --- App ---
PROJECT_NAME="School POS System"
ENVIRONMENT="development"                 # development | production
DATABASE_URL="mysql+pymysql://usuario:password@localhost/school_pos_db"
SECRET_KEY="cambia-esta-clave-por-una-de-32-caracteres-o-mas"
# Cifra secretos en reposo (smtp_pass). Obligatoria en producción (32+ caracteres).
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SETTINGS_ENCRYPTION_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_EXPIRE_MINUTES=30
API_V1_STR="/api/v1"
ALLOWED_ORIGINS="http://localhost:5173"   # en producción: https://tu-dominio.com (nunca "*")
PUBLIC_BASE_URL="http://localhost:8000"   # en producción: https://tu-dominio.com
FRONTEND_URL="http://localhost:5173"
APP_TIMEZONE="America/Bogota"
NFC_EXECUTABLE_PATH=""
NFC_EXECUTABLE_VERSION="1.0.0"

# --- Admin inicial (solo para el seed; no se sobrescribe si ya existe) ---
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""                 # mínimo 10 caracteres, con letras y números
ADMIN_FORCE_CHANGE=true

# ===== PayU PSE (única pasarela) =====
PAYU_MERCHANT_ID="xxxxxx"
PAYU_API_KEY="xxxxxx"
PAYU_API_LOGIN="xxxxxx"
PAYU_ACCOUNT_ID="xxxxxx"
PAYU_IS_TEST=true
PAYU_URL="https://sandbox.api.payulatam.com/payments-api/4.0/service.cgi"
# Producción: https://api.payulatam.com/payments-api/4.0/service.cgi

# ===== Límites =====
PAYMENT_CURRENCY="COP"
MIN_RECHARGE_AMOUNT=1000
MAX_RECHARGE_AMOUNT=500000
MAX_IMPORT_BYTES=10485760
MAX_UPLOAD_BYTES=2097152
