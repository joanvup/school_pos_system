# ===== School POS — variables de entorno =====
# Copia este archivo a .env y pon los valores reales.

# --- App ---
PROJECT_NAME="School POS System"
DATABASE_URL="mysql+pymysql://usuario:password@localhost/school_pos_db"
SECRET_KEY="cambia-esta-clave"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_V1_STR="/api/v1"
ALLOWED_ORIGINS="*"
FRONTEND_URL="http://localhost:5173"
NFC_EXECUTABLE_PATH=""
NFC_EXECUTABLE_VERSION="1.0.0"

# ===== PayU PSE (pasarela activa por defecto) =====
PAYU_MERCHANT_ID="xxxxxx"
PAYU_API_KEY="xxxxxx"
PAYU_API_LOGIN="xxxxxx"
PAYU_ACCOUNT_ID="xxxxxx"
PAYU_IS_TEST=True
PAYU_URL="https://sandbox.api.payulatam.com/payments-api/4.0/service.cgi"
# Producción: https://api.payulatam.com/payments-api/4.0/service.cgi

# ===== Wompi (activa cuando completes credenciales sandbox) =====
WOMPI_PUBLIC_KEY="pub_test_xxxxxx"
WOMPI_PRIVATE_KEY="sk_test_xxxxxx"
WOMPI_WEBHOOK_SECRET="wompi_webhook_secret"
WOMPI_IS_TEST=True
WOMPI_URL="https://sandbox.wompi.co/v1"

# ===== Mercado Pago (activa cuando completes test credentials) =====
MP_ACCESS_TOKEN="APP_USR-xxxxxxxx-xxxxx-xxxx"
MP_WEBHOOK_SECRET="mp_webhook_secret"
MP_URL="https://api.mercadopago.com"